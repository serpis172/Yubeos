{
  "name": "yubeos-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node ../scripts/keep-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node ../scripts/check-raw-colors.mjs",
    "test": "vitest run",
    "gen": "openapi-typescript ../api/openapi.yaml -o src/lib/api.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.13.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
